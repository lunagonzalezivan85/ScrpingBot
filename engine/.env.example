# Archivo de configuración del Motor Python
# Copia este archivo como .env y edita los valores si es necesario

# Configuración de Base de Datos MySQL (XAMPP)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=prospectos_crm

# Proveedor de Inteligencia Artificial
# Opciones para LLM_PROVIDER: "google", "openai", "ollama"
LLM_PROVIDER=google
LLM_MODEL=google_genai/gemini-3.5-flash-lite
# O si usas OpenAI:
# LLM_PROVIDER=openai
# LLM_MODEL=openai/gpt-4o-mini
# O si usas Ollama local:
# LLM_PROVIDER=ollama
# LLM_MODEL=ollama/llama3.2
# OLLAMA_BASE_URL=http://localhost:11434

# API Key del proveedor (deja en blanco si usas Ollama)
API_KEY=
